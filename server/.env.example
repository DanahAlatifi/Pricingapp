# ───────────────────────────────────────────────
# إعدادات السيرفر
# ───────────────────────────────────────────────
PORT=3000

# سر توقيع الـ JWT — غيّره لقيمة عشوائية طويلة وسرية في الإنتاج
JWT_SECRET=change_this_to_a_long_random_secret_string

# مدة صلاحية الجلسة (بالساعات)
SESSION_HOURS=12

# مفتاح تشفير كلمة مرور المستخدم في ذاكرة السيرفر (32 حرف)
SESSION_ENC_KEY=32_char_encryption_key_change_me!

# ───────────────────────────────────────────────
# رابط أودو وقاعدة البيانات يدخلهما المستخدم من شاشة الدخول.
# قاعدة البيانات تُكتشف تلقائياً من الرابط.
# (اتركي القيمتين فارغتين — موجودتان فقط كاحتياطي اختياري للتطوير)
# ───────────────────────────────────────────────
DEFAULT_ODOO_URL=
DEFAULT_ODOO_DB=

# (اختياري) قائمة سماح بنطاقات أودو المسموحة — للحماية في الإنتاج
ODOO_ALLOWED_HOSTS=
